<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingLeft="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/memdbg_title"
                android:textColor="#ffffff"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/state_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#d0d0d0"
                android:textSize="11sp"
                tools:text="RUNNING · run #1 · 120 objects · 14 classes" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/close" />
    </LinearLayout>

    <!-- Tabs -->
    <LinearLayout
        android:id="@+id/tab_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingLeft="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingRight="4dp">

        <Button
            android:id="@+id/tab_scan"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/memdbg_tab_scan"
            android:textSize="12sp" />

        <Button
            android:id="@+id/tab_memory"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/memdbg_tab_memory"
            android:textSize="12sp" />

        <Button
            android:id="@+id/tab_watch"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/memdbg_tab_watch"
            android:textSize="12sp" />

        <Button
            android:id="@+id/tab_frozen"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/memdbg_tab_frozen"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===================== Scan ===================== -->
        <ScrollView
            android:id="@+id/pane_scan"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/memdbg_scope"
                    android:textColor="?attr/textColorSecondary"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spin_scope"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_marginRight="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/memdbg_type"
                            android:textColor="?attr/textColorSecondary"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/spin_type"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginLeft="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/memdbg_mode"
                            android:textColor="?attr/textColorSecondary"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/spin_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <EditText
                    android:id="@+id/edit_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/memdbg_value"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="?attr/textColorPrimary" />

                <CheckBox
                    android:id="@+id/check_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/memdbg_group"
                    android:textColor="?attr/textColorPrimary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/group_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/edit_group_window"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:hint="@string/memdbg_group_window"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLines="1"
                        android:textColor="?attr/textColorPrimary" />

                    <CheckBox
                        android:id="@+id/check_group_ordered"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginLeft="8dp"
                        android:text="@string/memdbg_group_ordered"
                        android:textColor="?attr/textColorPrimary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_new_scan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_marginRight="4dp"
                        android:layout_weight="1"
                        android:text="@string/memdbg_new_scan" />

                    <Button
                        android:id="@+id/btn_next_scan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginLeft="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_marginRight="4dp"
                        android:layout_weight="1"
                        android:text="@string/memdbg_next_scan" />

                    <Button
                        android:id="@+id/btn_reset_scan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginLeft="4dp"
                        android:layout_weight="1"
                        android:text="@string/memdbg_reset_scan" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/scan_progress_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:indeterminate="true" />

                    <Button
                        android:id="@+id/btn_cancel_scan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginLeft="8dp"
                        android:text="@string/memdbg_cancel_scan" />
                </LinearLayout>

                <TextView
                    android:id="@+id/scan_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/textColorSecondary"
                    android:textSize="12sp"
                    tools:text="3 results" />

                <!-- Options -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/memdbg_options"
                    android:textColor="?attr/textColorSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/check_big_endian"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/memdbg_big_endian"
                    android:textColor="?attr/textColorPrimary"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/check_pause_scan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/memdbg_pause_scan"
                    android:textColor="?attr/textColorPrimary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_marginRight="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/memdbg_alignment"
                            android:textColor="?attr/textColorSecondary"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/spin_alignment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginLeft="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/memdbg_encoding"
                            android:textColor="?attr/textColorSecondary"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/spin_encoding"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Scan sessions and their history in one row -->
                <LinearLayout
                    android:id="@+id/session_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spin_session"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/btn_history"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/memdbg_history" />
                </LinearLayout>

                <!-- Results -->
                <LinearLayout
                    android:id="@+id/results_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btn_more_results"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/memdbg_show_more"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <!-- ===================== Memory ===================== -->
        <ScrollView
            android:id="@+id/pane_memory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- which region is open, how to pick another, and the display mode -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/view_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/memdbg_view_empty"
                        android:textColor="?attr/textColorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_regions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/memdbg_regions" />

                </LinearLayout>

                <!-- data type used to read and edit values -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spin_view_type"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <Spinner
                        android:id="@+id/spin_view_mode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <EditText
                        android:id="@+id/edit_view_length"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:hint="@string/memdbg_view_length"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLines="1"
                        android:textColor="?attr/textColorPrimary"
                        android:visibility="gone" />

                    <CheckBox
                        android:id="@+id/check_view_be"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/memdbg_view_big_endian"
                        android:textColor="?attr/textColorPrimary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_view_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/memdbg_more" />
                </LinearLayout>

                <!-- shown while nothing is open -->
                <TextView
                    android:id="@+id/view_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="@string/memdbg_view_empty_hint"
                    android:textColor="?attr/textColorSecondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_list_earlier"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/memdbg_show_earlier"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/hex_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_list_more"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/memdbg_show_more"
                    android:visibility="gone" />

                <!-- hex mode only: the selected value and its other interpretations -->
                <TextView
                    android:id="@+id/view_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="?attr/colorAccent"
                    android:textSize="12sp"
                    android:typeface="monospace" />

                <TextView
                    android:id="@+id/view_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?attr/textColorPrimary"
                    android:textSize="12sp"
                    android:typeface="monospace" />
            </LinearLayout>
        </ScrollView>

        <!-- ===================== Watch ===================== -->
        <ScrollView
            android:id="@+id/pane_watch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/watch_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- ===================== Frozen ===================== -->
        <ScrollView
            android:id="@+id/pane_frozen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/memdbg_freeze_period"
                        android:textColor="?attr/textColorSecondary"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/edit_freeze_period"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLines="1"
                        android:textColor="?attr/textColorPrimary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/frozen_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

    </FrameLayout>

</LinearLayout>
